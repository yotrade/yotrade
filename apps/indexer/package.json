{
  "name": "@yotrade/indexer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen": "envio codegen",
    "dev": "envio dev",
    "start": "envio start",
    "typecheck": "envio codegen && tsc --noEmit",
    "test": "envio codegen && vitest run --test-timeout=20000",
    "test:live": "envio codegen && INDEXER_LIVE=1 vitest run test/live.test.ts --test-timeout=120000"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "envio": "^3.12.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
