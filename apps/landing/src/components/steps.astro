---
import { STEPS } from "../data/site.ts";
---

<section id="how" class="section">
  <div class="wrap">
    <p class="eyebrow reveal">How it works</p>
    <h2 class="h2 reveal" style="--delay: 60ms">A quiz night, but the questions are markets.</h2>
    <p class="lead reveal" style="--delay: 120ms">
      Everyone knows what to do in the first ten seconds: a code on the wall, a phone in hand, a board that moves.
    </p>
    <ol class="steps">
      {
        STEPS.map((step, index) => (
          <li class="step reveal" style={`--delay: ${index * 90}ms`}>
            <span class="n">{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .section {
    padding: 110px 0;
  }

  .steps {
    display: grid;
    gap: 16px;
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .step {
    position: relative;
    padding: 28px;
    border-radius: var(--radius);
    background: var(--ink-2);
    border: 1px solid var(--line);
    transition:
      transform 300ms ease,
      border-color 300ms ease;
  }

  .step:hover {
    transform: translateY(-4px);
    border-color: rgb(157 139 255 / 0.4);
  }

  .n {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 700;
    color: var(--accent-2);
  }

  h3 {
    margin: 18px 0 0;
    font-size: 22px;
    letter-spacing: -0.02em;
  }

  p {
    margin: 10px 0 0;
    color: var(--muted);
  }

  @media (min-width: 720px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1080px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
