---
import { TICKER } from "../data/site.ts";

// Twice over, so the strip loops without a gap.
const items = [...TICKER, ...TICKER];
---

<div class="ticker" aria-label="What YoTrade does">
  <div class="track">
    {items.map((item, index) => <span aria-hidden={index >= TICKER.length ? "true" : undefined}>{item}</span>)}
  </div>
</div>

<style>
  .ticker {
    overflow: hidden;
    border-block: 1px solid var(--line);
    background: var(--ink-2);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .track {
    display: flex;
    width: max-content;
    animation: scroll 40s linear infinite;
  }

  span {
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 20px 14px;
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
    color: var(--muted);
  }

  span::after {
    content: "✦";
    color: var(--accent-2);
  }

  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }
</style>
