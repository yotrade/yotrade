---
import { LINKS } from "../data/site.ts";
---

<footer class="bg-page px-6 pb-10">
  <div class="max-w-[88rem] mx-auto border-t border-black/10 pt-8 flex flex-wrap items-center justify-between gap-4">
    <p class="text-black/60 text-sm">
      YoTrade · Built for the Monad Metropolis hackathon. Testnet only: funds have no real value.
    </p>
    <div class="flex gap-6 text-sm">
      <a href={LINKS.app} class="text-black/60 hover:text-black transition-colors">App</a>
      <a href={LINKS.repo} class="text-black/60 hover:text-black transition-colors">GitHub</a>
    </div>
  </div>
</footer>
