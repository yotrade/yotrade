---
import type { Wordmark } from "../data/site.ts";

interface Props {
  items: readonly Wordmark[];
  /** Seconds per loop. */
  duration: number;
  /** Space around each name, as a Tailwind margin class. */
  gap: string;
  tone: string;
  label: string;
}
const { items, duration, gap, tone, label } = Astro.props;
---

<div class="w-full overflow-hidden" aria-label={label}>
  <div class="marquee-track" style={`--marquee-duration: ${duration}s`}>
    {
      [...items, ...items].map((item, index) => (
        <span
          class:list={[gap, "shrink-0 whitespace-nowrap", tone]}
          style={item.style}
          aria-hidden={index >= items.length ? "true" : undefined}
        >
          {item.name}
        </span>
      ))
    }
  </div>
</div>
