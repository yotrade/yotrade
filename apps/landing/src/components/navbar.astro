---
import { LINKS, NAV } from "../data/site.ts";
---

<nav class="absolute top-0 left-0 right-0 z-20 px-6 py-5">
  <div class="flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5" aria-label="YoTrade home">
      <img src="/logo.png" alt="" width="28" height="28" class="w-7 h-7 rounded-full" />
      <span class="text-2xl font-medium tracking-tight text-black">YoTrade</span>
    </a>
    <div class="hidden md:flex items-center gap-8">
      {
        NAV.map((item) => (
          <a href={item.href} class="text-base text-gray-700 hover:text-black font-medium transition-colors duration-200">
            {item.label}
          </a>
        ))
      }
    </div>
    <a
      href={LINKS.app}
      class="bg-black text-white text-base font-medium px-7 py-2.5 rounded-full hover:bg-gray-800 transition-colors duration-200"
    >
      Open App
    </a>
  </div>
</nav>
