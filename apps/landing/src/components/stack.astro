---
import { STACK } from "../data/site.ts";
---

<section class="section">
  <div class="wrap">
    <p class="eyebrow reveal">Built on</p>
    <h2 class="h2 reveal" style="--delay: 60ms">Fast enough to feel like a live sport.</h2>
    <p class="lead reveal" style="--delay: 120ms">
      Sub-second finality makes a leaderboard move like a scoreboard, and fees small enough for dozens of trades
      from a small account.
    </p>
    <ul class="logos">
      {
        STACK.map((item, index) => (
          <li class="reveal" style={`--delay: ${index * 60}ms`}>
            {item.logo ? (
              <img src={item.logo} alt="" width="36" height="36" />
            ) : (
              <span class="mark">{item.name.charAt(0)}</span>
            )}
            <div>
              <strong>{item.name}</strong>
              <span>{item.role}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .section {
    padding: 40px 0 110px;
  }

  .logos {
    display: grid;
    gap: 12px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    border-radius: 20px;
    border: 1px solid var(--line);
    background: rgb(255 255 255 / 0.03);
  }

  li img,
  .mark {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .mark {
    display: grid;
    place-items: center;
    background: rgb(110 84 255 / 0.25);
    font-weight: 800;
  }

  strong {
    display: block;
    font-size: 16px;
  }

  li span:not(.mark) {
    font-size: 14px;
    color: var(--muted);
  }

  @media (min-width: 640px) {
    .logos {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .logos {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
