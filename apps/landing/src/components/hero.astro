---
import { LINKS, STACK } from "../data/site.ts";
import Marquee from "./marquee.astro";
import PillButton from "./pill-button.astro";
---

<section class="flex-1 px-6 pt-20 pb-6 flex items-end">
  <div class="relative w-full rounded-2xl overflow-hidden" style="height: calc(100vh - 96px); min-height: 620px">
    <video
      class="object-cover absolute inset-0 w-full h-full"
      src="/media/hero.mp4"
      poster="/media/hero-poster.jpg"
      autoplay
      muted
      loop
      playsinline
      aria-hidden="true"></video>
    <div class="relative z-10 flex flex-col items-start justify-start h-full p-8 pt-28 md:p-12 md:pt-36">
      <h1 class="text-black text-5xl md:text-6xl font-medium leading-tight max-w-xl mb-4" style="letter-spacing: -0.04em">
        Who's the best<br />trader here?
      </h1>
      <p class="text-black/70 text-base md:text-lg max-w-md mb-8 leading-relaxed">
        Host a trading tournament for your community in three taps. Friends join with one passkey, trade real Kuru order
        books or go up to 100x, and the contract pays the winners.
      </p>
      <PillButton href={LINKS.host} label="Host a game" large />
      <div class="mt-auto md:mt-24 w-full max-w-md">
        <Marquee items={STACK} duration={22} gap="mx-7" tone="text-black/60" label="Built with" />
      </div>
    </div>
  </div>
</section>
