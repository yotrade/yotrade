---
import { FAIRNESS } from "../data/site.ts";
---

<section id="fair" class="section">
  <div class="wrap grid">
    <div class="intro">
      <p class="eyebrow reveal">Fair play</p>
      <h2 class="h2 reveal" style="--delay: 60ms">A prize is only as good as the score.</h2>
      <p class="lead reveal" style="--delay: 120ms">
        A room that wants to win will look for the gap. The score is built so there is none, and so anyone can check it.
      </p>
      <div class="podium reveal" style="--delay: 180ms" aria-hidden="true">
        <div class="bar b2"><span>2</span></div>
        <div class="bar b1"><span>1</span></div>
        <div class="bar b3"><span>3</span></div>
      </div>
    </div>
    <ul class="list">
      {
        FAIRNESS.map((item, index) => (
          <li class="reveal" style={`--delay: ${index * 90}ms`}>
            <img src="/icons/check.svg" alt="" width="20" height="20" />
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .section {
    padding: 110px 0;
  }

  .grid {
    display: grid;
    gap: 56px;
  }

  .podium {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    height: 200px;
    margin-top: 48px;
    max-width: 360px;
  }

  .bar {
    flex: 1;
    display: flex;
    justify-content: center;
    padding-top: 14px;
    border-radius: 18px 18px 0 0;
    font-family: var(--mono);
    font-size: 30px;
    font-weight: 700;
    color: var(--ink);
    transform-origin: bottom;
    animation: rise 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-play-state: paused;
  }

  .podium:global(.in) .bar {
    animation-play-state: running;
  }

  .b1 {
    height: 100%;
    background: linear-gradient(180deg, var(--gold), #f5b940);
    animation-delay: 200ms;
  }

  .b2 {
    height: 72%;
    background: linear-gradient(180deg, #e6e9f2, #b9bfcf);
    animation-delay: 350ms;
  }

  .b3 {
    height: 56%;
    background: linear-gradient(180deg, #ffb27a, #f08a4b);
    animation-delay: 500ms;
  }

  .list {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    gap: 16px;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--ink-2);
    border: 1px solid var(--line);
  }

  li img {
    flex-shrink: 0;
    margin-top: 4px;
    filter: invert(78%) sepia(29%) saturate(700%) hue-rotate(80deg);
  }

  h3 {
    margin: 0;
    font-size: 19px;
  }

  p {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 15px;
  }

  @keyframes rise {
    from {
      transform: scaleY(0);
    }
  }

  @media (min-width: 960px) {
    .grid {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: start;
    }
  }
</style>
