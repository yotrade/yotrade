---
import { LINKS, MODES } from "../data/site.ts";
import ArrowRight from "./arrow-right.astro";
---

<section id="modes" class="bg-page px-6 py-24">
  <div class="max-w-[88rem] mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
    <div class="md:pr-12 md:pt-2 reveal">
      <p class="text-black/60 text-sm mb-2">YoTrade in practice</p>
      <h2 class="text-5xl md:text-6xl font-medium leading-none mb-6 text-black" style="letter-spacing: -0.04em">
        Game modes
      </h2>
      <p class="text-black/60 text-base leading-relaxed max-w-sm">
        Real order books for the careful, up to 100x for the brave, and a room code for everyone. Pick the game, the
        prize and who may join.
      </p>
      <div class="mt-10 flex flex-wrap gap-2" role="tablist" aria-label="Game modes">
        {
          MODES.map((mode, index) => (
            <button
              type="button"
              role="tab"
              data-mode={mode.id}
              aria-selected={index === 0 ? "true" : "false"}
              class="mode-tab rounded-full px-5 py-2.5 text-base font-medium transition-colors duration-200 border border-black/10 aria-selected:bg-black aria-selected:text-white text-black/70 hover:text-black"
            >
              {mode.label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="reveal relative rounded-3xl overflow-hidden min-h-[720px]" style="--delay: 120ms">
      <video
        class="object-cover absolute inset-0 w-full h-full"
        src="/media/modes.mp4"
        poster="/media/modes-poster.jpg"
        autoplay
        muted
        loop
        playsinline
        aria-hidden="true"></video>
      {
        MODES.map((mode, index) => (
          <div class="mode-panel absolute inset-0 z-10 p-10 md:p-12" data-mode={mode.id} hidden={index !== 0}>
            <h3 class="text-4xl md:text-5xl font-medium leading-tight mb-5 text-black" style="letter-spacing: -0.03em">
              {mode.title}
            </h3>
            <p class="text-black/70 text-base max-w-md mb-8">{mode.body}</p>
            <a href={LINKS.app} class="group inline-flex items-center gap-3 text-black font-medium">
              <span class="w-9 h-9 rounded-full bg-white/80 backdrop-blur flex items-center justify-center group-hover:bg-white transition-colors">
                <ArrowRight class="w-4 h-4 text-black" />
              </span>
              Play it
            </a>
            <img
              src={mode.shot}
              alt={mode.alt}
              width="375"
              height="812"
              loading="lazy"
              class="mode-shot absolute right-6 md:right-10 bottom-0 h-[44%] md:h-[54%] w-auto aspect-[375/812] object-cover object-top rounded-t-[30px] border-[6px] border-b-0 border-black shadow-2xl"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Tabs over one card: the video stays, the words and the screenshot change.
  const tabs = document.querySelectorAll<HTMLButtonElement>(".mode-tab");
  const panels = document.querySelectorAll<HTMLElement>(".mode-panel");
  for (const tab of tabs) {
    tab.addEventListener("click", () => {
      for (const other of tabs) {
        other.setAttribute("aria-selected", String(other === tab));
      }
      for (const panel of panels) {
        panel.hidden = panel.dataset["mode"] !== tab.dataset["mode"];
      }
    });
  }
</script>

<style>
  .mode-panel:not([hidden]) .mode-shot {
    animation: rise 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @keyframes rise {
    from {
      transform: translateY(40px);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mode-panel:not([hidden]) .mode-shot {
      animation: none;
    }
  }
</style>
