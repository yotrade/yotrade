---
import { LINKS } from "../data/site.ts";
---

<header class="nav">
  <div class="wrap row">
    <a href="/" class="brand" aria-label="YoTrade home">
      <img src="/logo.png" alt="" width="36" height="36" />
      <span>YoTrade</span>
    </a>
    <nav aria-label="Sections">
      <a href="#how">How it works</a>
      <a href="#features">Features</a>
      <a href="#fair">Fair play</a>
    </nav>
    <a class="btn btn-primary cta" href={LINKS.app}>Open app</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(14px);
    background: rgb(14 9 28 / 0.72);
    border-bottom: 1px solid var(--line);
  }

  .row {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 68px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 19px;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .brand img {
    border-radius: 50%;
  }

  nav {
    display: none;
    gap: 28px;
    margin-left: auto;
    font-size: 15px;
    font-weight: 500;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    transition: color 200ms ease;
  }

  nav a:hover {
    color: var(--text);
  }

  .cta {
    margin-left: auto;
    min-height: 42px;
    padding: 0 18px;
    font-size: 14px;
  }

  @media (min-width: 820px) {
    nav {
      display: flex;
    }

    .cta {
      margin-left: 8px;
    }
  }
</style>
