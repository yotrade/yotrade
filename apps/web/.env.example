# Registrable domain the app is served from. Passkeys are scoped to it.
NEXT_PUBLIC_RP_ID=localhost
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
# Optional: use Alchemy instead of the public RPC. This one ships to the browser: restrict it to the app's domain.
NEXT_PUBLIC_ALCHEMY_API_KEY=
# Envio Cloud GraphQL endpoint: `envio-cloud deployment endpoint yotrade <commit> yotrade`
NEXT_PUBLIC_INDEXER_URL=https://indexer.dev.hyperindex.xyz/2d1cdb5/v1/graphql

# Local end-to-end runs only, ignored in production builds: 32 bytes of hex passkey entropy
# Only used when a browser has localStorage["yotrade.e2e"] = "1" (the E2E scripts set it); people testing by hand get the real passkey.
# NEXT_PUBLIC_E2E_PRF_SEED=

# Server only. Alchemy key for the drip, scoring and finalize; falls back to the public one above.
ALCHEMY_API_KEY=
# Server only. Wallet that funds new passkey accounts with testnet MON (keep a small float).
DRIP_PRIVATE_KEY=
# Server only. Account with SCORER_ROLE on TournamentManager; posts results after a tournament ends.
SCORER_PRIVATE_KEY=
# Server only. Moonshot AI key for the live commentator: https://platform.kimi.ai
# Any OpenAI-compatible endpoint that serves Kimi. Through OpenRouter:
#   KIMI_BASE_URL=https://openrouter.ai/api/v1 and KIMI_MODEL=moonshotai/kimi-k2.5
KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k3
# Server only. Pyth Hermes key for futures price updates: https://pythdata.app
PYTH_API_KEY=
# PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
# Server only. Vercel Blob token for logo uploads: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=
