# Registrable domain the app is served from. Passkeys are scoped to it.
NEXT_PUBLIC_RP_ID=localhost
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
# Optional: use Alchemy instead of the public RPC
NEXT_PUBLIC_ALCHEMY_API_KEY=
# Envio Cloud GraphQL endpoint: `envio-cloud deployment endpoint yotrade <commit> yotrade`
NEXT_PUBLIC_INDEXER_URL=https://indexer.dev.hyperindex.xyz/78dbffe/v1/graphql

# Server only. Wallet that funds new passkey accounts with testnet MON (keep a small float).
DRIP_PRIVATE_KEY=
# Server only. Account with SCORER_ROLE on TournamentManager; posts results after a tournament ends.
SCORER_PRIVATE_KEY=
