{
  "name": "@yotrade/contracts",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "forge build",
    "test": "forge test --no-match-path 'test/fork/*'",
    "test:fork": "forge test --match-path 'test/fork/*'",
    "test:invariant": "forge test --match-path 'test/invariant/*'",
    "coverage": "forge coverage --no-match-path 'test/fork/*' --no-match-coverage '(test|script)' --report summary",
    "snapshot": "forge snapshot --no-match-path 'test/fork/*' --no-match-test 'testFuzz|invariant'",
    "snapshot:check": "forge snapshot --check --tolerance 5 --no-match-path 'test/fork/*' --no-match-test 'testFuzz|invariant'",
    "lint": "forge fmt --check",
    "format": "forge fmt"
  }
}
