{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", ".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_*"]
    },
    "test": {
      "dependsOn": ["build", "^build"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck", "build"]
    }
  }
}
