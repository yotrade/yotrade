# Conventional Commits: type(scope)!: subject
subject=$(head -n1 "$1")
case "$subject" in Merge\ *|Revert\ *) exit 0 ;; esac

if ! printf '%s' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .{1,88}$'; then
  echo "commit-msg: subject must follow Conventional Commits, e.g. 'feat(contracts): add claim deadline'" >&2
  exit 1
fi
